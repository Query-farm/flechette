{
  "name": "@query-farm/flechette",
  "version": "2.4.0",
  "description": "Fast, lightweight access to Apache Arrow data — Query Farm fork of @uwdata/flechette with per-record-batch custom_metadata, multi-batch IPC stream encoding (tablesToIPC/concatTables), and foreign Arrow type support for VGI.",
  "keywords": [
    "arrow",
    "data",
    "access",
    "ipc",
    "vgi",
    "query-farm"
  ],
  "license": "BSD-3-Clause",
  "author": "Jeffrey Heer (https://idl.uw.edu)",
  "contributors": [
    "Query Farm LLC (https://query.farm)"
  ],
  "type": "module",
  "main": "./dist/flechette.cjs",
  "module": "./src/index.js",
  "jsdelivr": "./dist/flechette.min.js",
  "unpkg": "./dist/flechette.min.js",
  "types": "./dist/types/index-types.d.ts",
  "files": [
    "src",
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Query-farm/flechette#readme",
  "bugs": {
    "url": "https://github.com/Query-farm/flechette/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Query-farm/flechette.git"
  },
  "scripts": {
    "perf": "node perf/run-all.js",
    "perf:build": "node perf/build-perf.js",
    "perf:decode": "node perf/decode-perf.js",
    "perf:encode": "node perf/encode-perf.js",
    "prebuild": "rimraf dist && mkdir dist",
    "build": "rollup -c rollup.config.js",
    "types": "tsc --project tsconfig.json",
    "postbuild": "npm run types",
    "lint": "eslint src test",
    "test:unit": "vitest",
    "test": "vitest --run",
    "prepublishOnly": "npm run test && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "apache-arrow": "^21.1.0",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "lz4js": "0.2.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.1",
    "rollup-plugin-bundle-size": "^1.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "zstd-codec": "0.1.5"
  }
}
